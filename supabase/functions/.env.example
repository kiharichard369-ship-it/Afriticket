# Copy this file to a private local env file or set these with `supabase secrets set`.
# Never commit real values. SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are
# injected automatically into deployed Supabase Edge Functions.
PAYMENT_PROVIDER=mpesa
ALLOWED_ORIGIN=https://<staging-frontend-domain>

# Add the actual Daraja sandbox values when available.
MPESA_CONSUMER_KEY=<daraja-sandbox-consumer-key>
MPESA_CONSUMER_SECRET=<daraja-sandbox-consumer-secret>
MPESA_SHORTCODE=3432873
MPESA_PASSKEY=<daraja-sandbox-passkey>
MPESA_BASE_URL=https://sandbox.safaricom.co.ke

# Generate a long random value, then use the same value in both places.
# Example callback URL:
# https://<project-ref>.supabase.co/functions/v1/mpesa-webhook/<webhook-secret>
MPESA_CALLBACK_URL=https://<project-ref>.supabase.co/functions/v1/mpesa-webhook/<webhook-secret>
MPESA_WEBHOOK_SECRET=<webhook-secret>
