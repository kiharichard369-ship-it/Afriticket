# Supabase project credentials — Project Settings → API in the Supabase dashboard.
# Safe to expose in the browser bundle: this is the anon/public key, not the service role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Never put the service_role key in a Vite-prefixed variable — it would ship
# to the browser. It belongs only in Edge Function secrets / server env vars,
# set later in Phase 2/3.
